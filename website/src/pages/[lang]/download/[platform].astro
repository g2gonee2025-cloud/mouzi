---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import DownloadCards from '../../../components/DownloadCards.astro';
import { translatedLocales, type Locale } from '../../../i18n';
import { corePageCopy } from '../../../i18n/core-pages';
import { localizedSigningMessage } from '../../../i18n/download';
import { site } from '../../../config/site';

export function getStaticPaths(){const platforms=['windows','linux'] as const;return translatedLocales.flatMap(lang=>platforms.map(platform=>({params:{lang,platform},props:{lang,platform}})));}
const {lang,platform}=Astro.props as {lang:Exclude<Locale,'en'>;platform:'windows'|'linux'};
const signingMessage = () => localizedSigningMessage(lang);
const labels={
 es:{leadW:'Tres versiones, una aplicación. El instalador sirve para la mayoría y el MSI para despliegues. Ejecuta el EXE portátil desde la carpeta o unidad USB que elijas.',leadL:'AppImage funciona sin instalación. DEB y RPM se integran con el gestor de paquetes.',w:[['Instalación','Al terminar la instalación, Mouzi aparece en la bandeja del sistema. En el primer inicio, vigila Descargas en modo silencioso con reglas iniciales. Puede mover archivos que ya están directamente en esa carpeta.','Guía de primeros pasos'],['Aviso SmartScreen',signingMessage()+' Mientras tanto Windows puede mostrar “Windows protegió su PC”. Comprueba que el nombre coincide con la versión oficial antes de elegir Más información y Ejecutar de todas formas.'],['Versión portátil','Ejecuta el EXE directamente, incluso desde una unidad USB. Las reglas, los ajustes y el historial se guardan en el mismo perfil de Windows que usa la versión instalada. La base de datos está en %APPDATA%\\mouzi\\mouzi\\data\\mouzi.db. Si activaste «Iniciar con el sistema», desactívalo en Ajustes antes de borrar el EXE. Los datos quedan en el perfil.'],['Requisitos','Windows 10 u 11 de 64 bits; unos 20 MB; la versión portátil no requiere permisos de administrador.'],['Siguientes pasos','Consulta la guía de Windows o la documentación de reglas.']],l:[['AppImage','Da permiso con chmod +x y ejecuta el archivo. No requiere instalación ni root; AppImageLauncher puede añadirlo al menú y al inicio.'],['DEB (Debian, Ubuntu, Mint)','Instala con: sudo apt install ./Mouzi_'+site.version+'_amd64.deb'],['RPM (Fedora, openSUSE)','Instala con: sudo dnf install ./Mouzi-'+site.version+'-1.x86_64.rpm'],['Icono de bandeja','Mouzi vive en la bandeja. GNOME necesita la extensión AppIndicator; la documentación explica Wayland.'],['Siguientes pasos','Sigue la guía inicial para vigilar una carpeta y crear una regla; solución de problemas cubre los casos comunes.']]},
 pl:{leadW:'Trzy wydania, jedna aplikacja. Wybierz instalator do codziennego użytku albo MSI do wdrożeń. Przenośny plik EXE możesz uruchomić z wybranego folderu lub dysku USB.',leadL:'AppImage działa bez instalacji. DEB i RPM integrują się z menedżerem pakietów.',w:[['Instalacja','Po instalacji Mouzi pojawia się w zasobniku systemowym. Przy pierwszym uruchomieniu obserwuje folder Pobrane w trybie cichym i tworzy reguły początkowe. Może wtedy przenosić pliki, które już znajdują się bezpośrednio w tym folderze.','Pierwsze kroki'],['Ostrzeżenie SmartScreen',signingMessage()+' Windows może pokazać komunikat ochrony. Sprawdź nazwę pliku i oficjalne źródło przed wybraniem Więcej informacji i Uruchom mimo to.'],['Wersja portable','Uruchom plik EXE bezpośrednio, także z dysku USB. Reguły, ustawienia i historia są zapisywane w tym samym profilu Windows co w wersji instalowanej. Baza danych znajduje się w %APPDATA%\\mouzi\\mouzi\\data\\mouzi.db. Jeśli opcja „Uruchamiaj z systemem” jest włączona, wyłącz ją w ustawieniach przed usunięciem pliku EXE. Dane pozostają w profilu.'],['Wymagania','Windows 10 lub 11 64-bit, około 20 MB; portable nie wymaga administratora.'],['Następne kroki','Przeczytaj przewodnik Windows albo dokumentację reguł.']],l:[['AppImage','Nadaj uprawnienie chmod +x i uruchom plik. Bez instalacji i roota; AppImageLauncher może dodać menu i autostart.'],['DEB (Debian, Ubuntu, Mint)','Polecenie: sudo apt install ./Mouzi_'+site.version+'_amd64.deb'],['RPM (Fedora, openSUSE)','Polecenie: sudo dnf install ./Mouzi-'+site.version+'-1.x86_64.rpm'],['Ikona zasobnika','Mouzi działa w zasobniku. GNOME wymaga rozszerzenia AppIndicator; dokumentacja opisuje Wayland.'],['Następne kroki','Przewodnik startowy opisuje pierwszy folder i regułę, a rozwiązywanie problemów typowe przypadki.']]},
 de:{leadW:'Drei Varianten, eine App. Der Installer eignet sich für die meisten Nutzer, MSI für verwaltete Installationen. Die portable EXE lässt sich direkt aus einem Ordner oder von einem USB-Laufwerk starten.',leadL:'AppImage läuft ohne Installation. DEB und RPM integrieren sich in die Paketverwaltung.',w:[['Installation','Nach der Installation erscheint Mouzi im Infobereich. Beim ersten Start überwacht Mouzi den Ordner Downloads automatisch mit Standardregeln. Bereits vorhandene Dateien direkt in diesem Ordner können dabei verschoben werden.','Erste Schritte'],['SmartScreen',signingMessage()+' Windows kann warnen. Dateiname und offizielle Quelle prüfen, bevor „Weitere Informationen“ und „Trotzdem ausführen“ gewählt werden.'],['Portable Version','Starte die EXE direkt, auch von einem USB-Laufwerk. Regeln, Einstellungen und Verlauf liegen im selben Windows-Profil wie bei der installierten Version. Die Datenbank befindet sich unter %APPDATA%\\mouzi\\mouzi\\data\\mouzi.db. Wenn „Mit dem System starten“ aktiviert ist, schalte die Option in den Einstellungen aus, bevor du die EXE löschst. Die Daten bleiben im Profil.'],['Anforderungen','Windows 10/11 64-Bit, etwa 20 MB; portable ohne Administrator.'],['Nächste Schritte','Windows-Leitfaden oder Regeldokumentation lesen.']],l:[['AppImage','Mit chmod +x ausführbar machen und starten. Keine Installation oder root; AppImageLauncher kann Menü und Autostart integrieren.'],['DEB','sudo apt install ./Mouzi_'+site.version+'_amd64.deb'],['RPM','sudo dnf install ./Mouzi-'+site.version+'-1.x86_64.rpm'],['Tray-Symbol','Mouzi lebt im Tray. GNOME benötigt AppIndicator; Wayland-Hinweise stehen in der Dokumentation.'],['Nächste Schritte','Einstiegs- und Fehlerbehebungsleitfaden verwenden.']]},
 fr:{leadW:'Trois versions, une application. Choisissez le programme d’installation pour un usage courant ou le MSI pour un déploiement administré. Lancez l’EXE portable directement depuis un dossier ou une clé USB.',leadL:'AppImage fonctionne sans installation. DEB et RPM utilisent votre gestionnaire de paquets.',w:[['Installation','Après l’installation, Mouzi apparaît dans la zone de notification. Au premier lancement, Mouzi surveille le dossier Téléchargements en mode silencieux avec des règles par défaut. Il peut déplacer des fichiers déjà présents directement dans ce dossier.','Guide de démarrage'],['SmartScreen',signingMessage()+' Windows peut avertir. Vérifiez le nom et la source officielle avant Plus d’informations puis Exécuter quand même.'],['Version portable','Lancez l’EXE directement, y compris depuis une clé USB. Les règles, les paramètres et l’historique sont enregistrés dans le même profil Windows que pour la version installée. La base de données se trouve dans %APPDATA%\\mouzi\\mouzi\\data\\mouzi.db. Si l’option « Démarrer avec le système » est activée, désactivez-la dans les paramètres avant de supprimer l’EXE. Les données restent dans le profil.'],['Configuration requise','Windows 10/11 64 bits, environ 20 Mo ; aucun droit administrateur pour portable.'],['Étapes suivantes','Consultez le guide Windows ou les règles.']],l:[['AppImage','Rendez le fichier exécutable avec chmod +x puis lancez-le. Ni installation ni root ; AppImageLauncher peut l’intégrer.'],['DEB','sudo apt install ./Mouzi_'+site.version+'_amd64.deb'],['RPM','sudo dnf install ./Mouzi-'+site.version+'-1.x86_64.rpm'],['Icône de notification','Mouzi reste dans la zone de notification. GNOME exige AppIndicator ; la documentation couvre Wayland.'],['Étapes suivantes','Suivez le démarrage rapide et le dépannage.']]},
 it:{leadW:'Tre versioni, una sola app. Scegli il programma di installazione per l’uso quotidiano o il pacchetto MSI per le distribuzioni gestite. Avvia l’EXE portatile direttamente da una cartella o da un’unità USB.',leadL:'AppImage funziona senza installazione. DEB e RPM si integrano col gestore pacchetti.',w:[['Installazione','Dopo l’installazione, Mouzi appare nell’area di notifica. Al primo avvio monitora la cartella Download in modalità silenziosa con regole predefinite. Può spostare i file già presenti direttamente nella cartella.','Guida introduttiva'],['SmartScreen',signingMessage()+' Windows può avvisare. Controlla nome e fonte ufficiale prima di Altre informazioni e Esegui comunque.'],['Versione portable','Avvia l’EXE direttamente, anche da un’unità USB. Regole, impostazioni e cronologia sono salvate nello stesso profilo Windows della versione installata. Il database si trova in %APPDATA%\\mouzi\\mouzi\\data\\mouzi.db. Se «Avvia con il sistema» è attivo, disattivalo nelle impostazioni prima di eliminare l’EXE. I dati restano nel profilo.'],['Requisiti','Windows 10/11 64 bit, circa 20 MB; portable senza amministratore.'],['Passi successivi','Consulta la guida Windows o le regole.']],l:[['AppImage','Usa chmod +x e avvia. Nessuna installazione o root; AppImageLauncher può integrarlo.'],['DEB','sudo apt install ./Mouzi_'+site.version+'_amd64.deb'],['RPM','sudo dnf install ./Mouzi-'+site.version+'-1.x86_64.rpm'],['Icona nella barra','Mouzi vive nella barra. GNOME richiede AppIndicator; la documentazione tratta Wayland.'],['Passi successivi','Segui la guida iniziale e la risoluzione problemi.']]}
}[lang];
const title=platform==='windows'?'Mouzi for Windows':'Mouzi for Linux';const sections=platform==='windows'?labels.w:labels.l;const lead=platform==='windows'?labels.leadW:labels.leadL;
---
<BaseLayout title={`${title} — Mouzi`} description={lead} canonical={`/${lang}/download/${platform}`}><div class="mx-auto max-w-4xl px-5 py-16"><SectionHeading kicker={`${site.version} · ${platform==='windows'?'Windows 10 & 11 · x64':'x86_64'}`} title={title} lead={lead}/><div class="mt-10"><DownloadCards platform={platform}/></div><section class="prose mt-14">{sections.map(([h,b,firstRunGuide])=><><h2>{h}</h2><p>{b}{firstRunGuide && <> <a href="/docs/getting-started">{firstRunGuide}</a></>}</p></>)}</section><div class="mt-12"><a href={platform==='windows'?'/docs/windows':'/docs'} class="rounded-btn border border-line px-5 py-2.5">{platform==='windows'?corePageCopy[lang].download.windowsGuide:'Docs'}</a></div></div></BaseLayout>
